#!/usr/bin/env python3
import argparse
import json
import os
import secrets
import shutil
import sys
import uuid

sys.dont_write_bytecode = True

from agy_agentapi import AgentApiSession, DirectChild
from agy_control import endpoint
from agy_diagnose import diagnose
from agy_process import Child
from agy_registration import Registration
from agy_session import Session, signals, terminal


def registration(options, parser):
    launch_id = str(uuid.uuid4())
    identity = {"launch_id": launch_id}
    if options.defer_registration:
        if options.name is not None or options.team is not None:
            parser.error("--defer-registration conflicts with --name and --team")
        key = os.environb.pop(b"XATS_AGY_IDENTITY_KEY", b"")
        os.environb.pop(b"XATS_IDENTITY_KEY", None)
        try:
            key.decode("utf-8")
        except UnicodeDecodeError:
            parser.error("XATS_AGY_IDENTITY_KEY must be UTF-8")
        if not 16 <= len(key) <= 256:
            parser.error("XATS_AGY_IDENTITY_KEY requires 16-256 UTF-8 bytes")
        identity["defer_registration"] = "1"
        return identity, Registration(launch_id, None, key)
    if not all(label and label.strip() for label in (options.name, options.team)):
        parser.error("--name and --team must both be non-empty")
    identity.update(name=options.name, team=options.team)
    return identity, Registration(launch_id, (options.name, options.team))


def main(args):
    parser = argparse.ArgumentParser(
        usage="%(prog)s (--name NAME --team TEAM [--diagnose LAUNCH_UUID] "
              "| --defer-registration) [-- agy参数...]",
        epilog="撤回受阻时, 单按 Ctrl+] 丢弃暂存按键并接管当前终端. "
               "本次启动后续仅允许手动输入.",
        allow_abbrev=False)
    parser.add_argument("--name")
    parser.add_argument("--team")
    parser.add_argument("--defer-registration", action="store_true")
    parser.add_argument("--agentapi", action="store_true")
    parser.add_argument("--diagnose", metavar="LAUNCH_UUID")
    parser.add_argument("--capabilities-json", action="store_true")
    split = args.index("--") if "--" in args else len(args)
    options = parser.parse_args(args[:split])
    if options.capabilities_json:
        if args != ["--capabilities-json"]:
            parser.error("--capabilities-json must be used alone")
        print(json.dumps({"defer_registration": 1, "agentapi_channel": 1}, separators=(",", ":")))
        return 0
    if options.diagnose is not None:
        if (options.defer_registration or options.agentapi or split != len(args)
                or not options.name or not options.team):
            parser.error("--diagnose requires --name and --team and takes no agy arguments")
        print(json.dumps(diagnose(options.diagnose, options.name, options.team)))
        return 0
    identity, binding = registration(options, parser)
    path = shutil.which("agy")
    if not path:
        parser.exit(127, "xats-agy: agy not found on PATH\n")
    if options.agentapi:
        bind_token = secrets.token_hex(32)
        with endpoint(identity["launch_id"]) as server:
            child = DirectChild(path, args[split + 1:], identity, bind_token)
            try:
                return AgentApiSession(server, binding, child, bind_token).run()
            finally:
                child.close()
    if not os.isatty(0):
        parser.error("interactive terminal required")
    with signals() as pending, endpoint(identity["launch_id"]) as server:
        child = Child(path, args[split + 1:], identity)
        try:
            with terminal():
                return Session(server, binding, child).run(pending)
        finally:
            child.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as error:
        sys.exit(f"xats-agy: {error}")
