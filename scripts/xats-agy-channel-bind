#!/usr/bin/env python3
import argparse
import json
import os
import socket
import stat
import sys
from pathlib import Path
from uuid import UUID

sys.dont_write_bytecode = True


def _valid_uuid(value):
    try:
        parsed = UUID(value)
    except ValueError:
        return False
    return str(parsed) == value.lower()


def _socket_path(launch_id):
    if not _valid_uuid(launch_id):
        raise ValueError("invalid XATS_AGY_LAUNCH_ID")
    root = Path("/tmp") / f"xats-agy-{os.getuid()}"
    path = root / f"{launch_id}.sock"
    for target, kind in ((root, stat.S_ISDIR), (path, stat.S_ISSOCK)):
        info = target.lstat()
        if not kind(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise PermissionError("unsafe launcher socket")
    return path


def _exchange(path, frame):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as peer:
        peer.settimeout(2.0)
        peer.connect(str(path))
        peer.sendall(json.dumps(frame, ensure_ascii=False).encode("utf-8") + b"\n")
        with peer.makefile("rb") as stream:
            line = stream.readline(4097)
    if not line.endswith(b"\n") or len(line) > 4096:
        raise ValueError("invalid launcher response")
    return json.loads(line.decode("utf-8"))


def main(args):
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument("--update-conversation", nargs="?", const="", default=None)
    options = parser.parse_args(args)

    launch_id = os.environ.get("XATS_AGY_LAUNCH_ID", "").strip()
    bind_token = os.environ.get("XATS_AGY_BIND_TOKEN", "").strip()
    conv_id = os.environ.get("ANTIGRAVITY_CONVERSATION_ID", "").strip()

    if options.update_conversation is not None:
        target_conv = options.update_conversation.strip() or conv_id
        if not launch_id or not bind_token or not target_conv:
            return 0
        reply = _exchange(_socket_path(launch_id), {
            "op": "update_conversation",
            "launch_id": launch_id,
            "bind_token": bind_token,
            "conversation_id": target_conv,
        })
        return 0 if reply.get("status") == "updated" else 1

    ls_addr = os.environ.get("ANTIGRAVITY_LS_ADDRESS", "").strip()
    csrf = os.environ.get("ANTIGRAVITY_CSRF_TOKEN", "").strip()
    exe = os.environ.get("ANTIGRAVITY_AGENTAPI_EXE", "").strip()
    missing = [name for name, val in (
        ("XATS_AGY_LAUNCH_ID", launch_id),
        ("XATS_AGY_BIND_TOKEN", bind_token),
        ("ANTIGRAVITY_CONVERSATION_ID", conv_id),
        ("ANTIGRAVITY_LS_ADDRESS", ls_addr),
        ("ANTIGRAVITY_CSRF_TOKEN", csrf),
    ) if not val]
    if missing:
        sys.stderr.write(f"xats-agy-channel-bind: missing {', '.join(missing)}\n")
        return 2

    frame = {
        "op": "bind_agentapi",
        "launch_id": launch_id,
        "bind_token": bind_token,
        "conversation_id": conv_id,
        "ls_address": ls_addr,
        "csrf_token": csrf,
    }
    if exe:
        frame["agentapi_exe"] = exe
    reply = _exchange(_socket_path(launch_id), frame)
    if reply.get("status") != "bound":
        detail = reply.get("detail") or reply.get("status") or "unknown"
        sys.stderr.write(f"xats-agy-channel-bind: bind failed ({detail})\n")
        return 1
    print("xats-agy-channel: bound")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as error:
        sys.exit(f"xats-agy-channel-bind: {error}")
